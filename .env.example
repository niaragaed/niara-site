# niara-site: configuração do fluxo real em /trade. TESTNET ONLY.
# Copie para .env.local (ignorado pelo git) e ajuste.
#
# Tudo aqui vai para o bundle do navegador (NEXT_PUBLIC_*): só valores PÚBLICOS.
# Nunca coloque aqui chave de operador, keystore, senha, DATABASE_URL ou a
# service role key do Supabase. RPC privado com API key também é segredo:
# use RPC público aqui.
# Os endereços abaixo vêm de niara-exchange-engine/config (commit d5b32d6).

# Order service do niara-exchange-engine (POST /v1/orders, /v1/orders/cancel,
# GET /v1/matches/:id). Precisa liberar CORS para a origem do site.
NEXT_PUBLIC_ENGINE_URL=http://127.0.0.1:8787

# Supabase niara-exchange-dev: leitura pública (RLS) de chains, listings e da
# view order_book. A anon key é pública por design.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Solana devnet -----------------------------------------------------------
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_DEVNET_PROGRAM_ID=B311xH3PcEx86gdRbuinrGrh1r9G2qzjDCji8uc6eD9v
NEXT_PUBLIC_SOLANA_DEVNET_USDT_MINT=8iWQ7VxYrkUv471vEoZ664eLwDzWinPiCJpRvcTUA24y
NEXT_PUBLIC_SOLANA_DEVNET_EXPLORER_TX=https://explorer.solana.com/tx/{tx}?cluster=devnet

