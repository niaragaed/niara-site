# niara-site: configuration of the real flow in /trade. TESTNET ONLY.
# Copy to .env.local (ignored by git) and adjust.
#
# Everything here goes into the browser bundle (NEXT_PUBLIC_*): PUBLIC values only.
# Never put an operator key, keystore, password, DATABASE_URL or the
# Supabase service role key here. A private RPC with an API key is a secret too:
# use a public RPC here.
# The addresses below come from niara-exchange-engine/config (commit d5b32d6).

# niara-exchange-engine order service (POST /v1/orders, /v1/orders/cancel,
# GET /v1/matches/:id). It must allow CORS for the site's origin.
NEXT_PUBLIC_ENGINE_URL=http://127.0.0.1:8787

# Supabase niara-exchange-dev: public (RLS) reads of chains, listings and the
# order_book view. The anon key is public by design.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Solana devnet -----------------------------------------------------------
NEXT_PUBLIC_SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_DEVNET_PROGRAM_ID=B311xH3PcEx86gdRbuinrGrh1r9G2qzjDCji8uc6eD9v
NEXT_PUBLIC_SOLANA_DEVNET_USDT_MINT=8iWQ7VxYrkUv471vEoZ664eLwDzWinPiCJpRvcTUA24y
NEXT_PUBLIC_SOLANA_DEVNET_EXPLORER_TX=https://explorer.solana.com/tx/{tx}?cluster=devnet

# --- Base Sepolia ------------------------------------------------------------
NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID=84532
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_SEPOLIA_SETTLEMENT=0x14C6F9DeD6C97F67149B4305c57331F9d3820B6F
NEXT_PUBLIC_BASE_SEPOLIA_USDT=0x4ED579b02B53d050624c0F04Fb1F4D9b1d347457
NEXT_PUBLIC_BASE_SEPOLIA_EXPLORER_TX=https://sepolia.basescan.org/tx/{tx}

# --- Robinhood Chain testnet -------------------------------------------------
NEXT_PUBLIC_ROBINHOOD_TESTNET_CHAIN_ID=46630
NEXT_PUBLIC_ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
NEXT_PUBLIC_ROBINHOOD_TESTNET_SETTLEMENT=0x14C6F9DeD6C97F67149B4305c57331F9d3820B6F
NEXT_PUBLIC_ROBINHOOD_TESTNET_USDT=0x4ED579b02B53d050624c0F04Fb1F4D9b1d347457
NEXT_PUBLIC_ROBINHOOD_TESTNET_EXPLORER_TX=https://explorer.testnet.chain.robinhood.com/tx/{tx}

# --- Tempo testnet (gas paid in pathUSD, Tempo 0x76 transaction) --------------
NEXT_PUBLIC_TEMPO_TESTNET_CHAIN_ID=42431
NEXT_PUBLIC_TEMPO_TESTNET_RPC_URL=https://rpc.moderato.tempo.xyz
NEXT_PUBLIC_TEMPO_TESTNET_SETTLEMENT=0x14C6F9DeD6C97F67149B4305c57331F9d3820B6F
NEXT_PUBLIC_TEMPO_TESTNET_USDT=0x4ED579b02B53d050624c0F04Fb1F4D9b1d347457
NEXT_PUBLIC_TEMPO_TESTNET_EXPLORER_TX=https://explore.testnet.tempo.xyz/tx/{tx}

# --- HyperEVM testnet: no v1 deployment yet (disabled until filled in) -------
NEXT_PUBLIC_HYPEREVM_TESTNET_CHAIN_ID=998
NEXT_PUBLIC_HYPEREVM_TESTNET_RPC_URL=https://rpc.hyperliquid-testnet.xyz/evm
NEXT_PUBLIC_HYPEREVM_TESTNET_SETTLEMENT=
NEXT_PUBLIC_HYPEREVM_TESTNET_USDT=
NEXT_PUBLIC_HYPEREVM_TESTNET_EXPLORER_TX=

# --- Ethereum Sepolia (old pilot: /pilot, /profile, /assets) ------------------
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# --- Wallets ------------------------------------------------------------------
# WalletConnect project id (Reown dashboard, cloud.reown.com). Public by design: it
# only identifies the app to the WalletConnect relay. Empty = WalletConnect is not
# offered and its hosts stay out of the CSP. In the Reown dashboard, allow only the
# site's domains (niaraglobal.com, and localhost for development).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Other Niara products (header links, opened in a new tab) ------------------
# Absolute https URLs; empty or non-https = the link is not shown.
NEXT_PUBLIC_REGISTER_URL=https://register.niaraglobal.com
NEXT_PUBLIC_SMES_URL=https://sme.niaraglobal.com
